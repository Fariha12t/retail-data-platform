FROM apache/airflow:2.10.5-python3.11
# Pipeline + dbt live in their own virtualenv so they never conflict with Airflow's pinned dependencies.
COPY requirements.txt /tmp/requirements.txt
RUN python -m venv /home/airflow/venv \
 && /home/airflow/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt
ENV PYTHONPATH=/opt/pipeline/src \
    PIPELINE_PYTHON=/home/airflow/venv/bin/python \
    DBT_BIN=/home/airflow/venv/bin/dbt \
    DBT_DIR=/opt/pipeline/dbt
