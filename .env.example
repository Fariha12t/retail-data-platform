# Copy to .env and adjust. Used by the CLI, dbt profile, docker-compose and the dashboard.
PG_HOST=localhost
PG_PORT=5432
PG_DB=warehouse
PG_USER=warehouse
PG_PASSWORD=warehouse

# Raw layer: "s3" (AWS S3 or MinIO) or "local" (folder, no services needed)
STORAGE_BACKEND=s3
S3_BUCKET=retail-raw
S3_ENDPOINT_URL=http://localhost:9000   # remove this line to use real AWS S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=ap-south-1
LOCAL_LAKE_DIR=data/lake

LANDING_DIR=data/landing
REPORTS_DIR=reports
API_BASE_URL=http://localhost:8000
SOURCE_HISTORY_START=2024-01-01

# Alerts (optional - leave empty to log only)
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Reliability / cost knobs
FRESHNESS_MAX_AGE_HOURS=26
MONTHLY_BUDGET_USD=25
S3_PRICE_PER_GB_MONTH=0.023
DB_PRICE_PER_GB_MONTH=0.115
COMPUTE_PRICE_PER_HOUR=0.10
